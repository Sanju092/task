<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YearPlanner" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/project_blue</item>
        <item name="colorPrimaryVariant">@color/project_indigo</item>
        <item name="colorOnPrimary">@android:color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/project_teal</item>
        <item name="colorSecondaryVariant">@color/project_green</item>
        <item name="colorOnSecondary">@android:color/white</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">?attr/colorSurfaceContainer</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        
        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.YearPlanner.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.YearPlanner.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.YearPlanner.LargeComponent</item>
    </style>

    <style name="Theme.YearPlanner.QuickAdd" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Custom shapes -->
    <style name="ShapeAppearance.YearPlanner.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.YearPlanner.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.YearPlanner.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>